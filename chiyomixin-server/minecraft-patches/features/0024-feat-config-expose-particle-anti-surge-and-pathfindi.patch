From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: albardoo02 <akshs@outlook.jp>
Date: Tue, 20 Oct 2026 18:26:20 +0900
Subject: [PATCH] feat(config): expose particle anti-surge and pathfinding
 throttle settings in chiyomixin.yml


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 823d8c9eafb509075b07c6404a2e5223e59a2e7e..e559331af76b831335322ecc2ab1fb452765dc7f 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -2149,9 +2149,10 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
             return false;
         } else {
             BlockPos blockPos = player.blockPosition();
-            double maxDist = overrideLimiter ? 64.0 : 32.0; // ChiyoMixin - clamp extreme 512m particle broadcast to 64m to protect lobbies
+            double maxDist = overrideLimiter ? world.chiyomixin.config.ChiyoMixinConfig.getMaxParticleDistance() : 32.0; // ChiyoMixin - configurable particle distance
             if (blockPos.closerToCenterThan(new Vec3(x, y, z), maxDist)) {
-                if (player.particlePacketCountThisTick++ > 300) {
+                int maxPackets = world.chiyomixin.config.ChiyoMixinConfig.getMaxParticlePacketsPerTick();
+                if (maxPackets > 0 && player.particlePacketCountThisTick++ > maxPackets) {
                     return false; // ChiyoMixin - anti-surge protection: prevent network buffer overflow / watchdog crash
                 }
                 player.connection.send(packet);
diff --git a/net/minecraft/world/entity/ai/navigation/PathNavigation.java b/net/minecraft/world/entity/ai/navigation/PathNavigation.java
index cc70b7473855ddfeafa6978b40440eb064be8632..f4a7af19473930b3098d520ba8ff06b0ab600ff0 100644
--- a/net/minecraft/world/entity/ai/navigation/PathNavigation.java
+++ b/net/minecraft/world/entity/ai/navigation/PathNavigation.java
@@ -214,8 +214,10 @@ public abstract class PathNavigation {
 
     public boolean moveTo(Entity entity, double speedModifier) {
         // ChiyoMixin start - pathfinding throttling: avoid recomputing A* every tick if target has barely moved and current path is still valid
-        if (this.path != null && !this.path.isDone() && this.targetPos != null) {
-            if (this.targetPos.closerToCenterThan(entity.position(), 2.0) && (net.minecraft.server.MinecraftServer.currentTick - this.lastPathfindSuccessTick < 6)) {
+        int throttleTicks = world.chiyomixin.config.ChiyoMixinConfig.getPathfindingThrottleTicks();
+        if (throttleTicks > 0 && this.path != null && !this.path.isDone() && this.targetPos != null) {
+            double throttleDist = world.chiyomixin.config.ChiyoMixinConfig.getPathfindingThrottleDistance();
+            if (this.targetPos.closerToCenterThan(entity.position(), throttleDist) && (net.minecraft.server.MinecraftServer.currentTick - this.lastPathfindSuccessTick < throttleTicks)) {
                 this.setSpeedModifier(speedModifier);
                 return true;
             }
diff --git a/net/minecraft/world/level/ServerExplosion.java b/net/minecraft/world/level/ServerExplosion.java
index 849c54e8cbb62ae5108f81d10abeef5512875a4f..d869facce8b7e384f63f17c637038de7ef9c2bbf 100644
--- a/net/minecraft/world/level/ServerExplosion.java
+++ b/net/minecraft/world/level/ServerExplosion.java
@@ -743,7 +743,7 @@ public class ServerExplosion implements Explosion {
 
     // Paper start - Optimize explosions
     private float getBlockDensity(Vec3 vec3d, Entity entity) {
-        if (entity instanceof net.minecraft.world.entity.item.PrimedTnt) {
+        if (world.chiyomixin.config.ChiyoMixinConfig.isTntFastExposure() && entity instanceof net.minecraft.world.entity.item.PrimedTnt) {
             return 1.0F; // ChiyoMixin - fast-path PrimedTnt: skip 16-point raycasting for other primed TNT entities
         }
         if (!this.level.paperConfig().environment.optimizeExplosions) {
diff --git a/world/chiyomixin/config/ChiyoMixinConfig.java b/world/chiyomixin/config/ChiyoMixinConfig.java
index 51a1ce4e68f719f7c70c36110cfc39640be8c827..9ca0e3b958d295ba9da2b33cebb66c349a44d5e6 100644
--- a/world/chiyomixin/config/ChiyoMixinConfig.java
+++ b/world/chiyomixin/config/ChiyoMixinConfig.java
@@ -10,7 +10,7 @@ import java.util.ArrayList;
 import java.util.List;
 
 public final class ChiyoMixinConfig {
-    private static final int VERSION = 2;
+    private static final int VERSION = 3;
     
     private static final List<ConfigComponent<?>> configComponentList = new ArrayList<>();
     
@@ -18,6 +18,12 @@ public final class ChiyoMixinConfig {
     private static final ConfigComponent<Integer> MAX_WORLD_THREADS = new ConfigComponent<>("max-world-threads", 0, 0);
     private static final ConfigComponent<Boolean> SHOW_CHIYOMIXIN_LOG = new ConfigComponent<>("show-detail-log", true, 0);
     private static final ConfigComponent<Boolean> SYNCHRONIZED_EVENT = new ConfigComponent<>("synchronized-event", true, 1);
+
+    private static final ConfigComponent<Integer> MAX_PARTICLE_PACKETS_PER_TICK = new ConfigComponent<>("anti-surge.max-particle-packets-per-player-per-tick", 300, 3);
+    private static final ConfigComponent<Double> MAX_PARTICLE_DISTANCE = new ConfigComponent<>("anti-surge.max-particle-distance", 64.0, 3);
+    private static final ConfigComponent<Integer> PATHFINDING_THROTTLE_TICKS = new ConfigComponent<>("performance.pathfinding-throttle-ticks", 6, 3);
+    private static final ConfigComponent<Double> PATHFINDING_THROTTLE_DISTANCE = new ConfigComponent<>("performance.pathfinding-throttle-distance", 2.0, 3);
+    private static final ConfigComponent<Boolean> TNT_FAST_EXPOSURE = new ConfigComponent<>("performance.tnt-fast-exposure", true, 3);
     
     private static void setDefaultValues(YamlConfiguration yml){
         int configVer = 0;
@@ -73,7 +79,20 @@ public final class ChiyoMixinConfig {
             configComponentList.add(this);
         }
         
-        private void setValue(Object value) {this.value = (T)value;}
+        @SuppressWarnings("unchecked")
+        private void setValue(Object value) {
+            if (value instanceof Number number) {
+                if (defaultValue instanceof Double) {
+                    this.value = (T) Double.valueOf(number.doubleValue());
+                    return;
+                }
+                if (defaultValue instanceof Integer) {
+                    this.value = (T) Integer.valueOf(number.intValue());
+                    return;
+                }
+            }
+            this.value = (T)value;
+        }
         
         private T getValue() {
             if(value != null) return value;
@@ -108,4 +127,14 @@ public final class ChiyoMixinConfig {
     public static boolean isShowLogs() {return SHOW_CHIYOMIXIN_LOG.getValue();}
     
     public static boolean isSynchronizedEvent(){return SYNCHRONIZED_EVENT.getValue();}
+
+    public static int getMaxParticlePacketsPerTick() {return MAX_PARTICLE_PACKETS_PER_TICK.getValue();}
+
+    public static double getMaxParticleDistance() {return MAX_PARTICLE_DISTANCE.getValue();}
+
+    public static int getPathfindingThrottleTicks() {return PATHFINDING_THROTTLE_TICKS.getValue();}
+
+    public static double getPathfindingThrottleDistance() {return PATHFINDING_THROTTLE_DISTANCE.getValue();}
+
+    public static boolean isTntFastExposure() {return TNT_FAST_EXPOSURE.getValue();}
 }
