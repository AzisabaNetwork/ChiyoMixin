Subject: [PATCH] perf(core): dynamic haveTime propagation, zero-alloc bypass
 caches, fast-path tasks, and player disconnect cleanup


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 80dd85ecb671a77154fe47f50898638f8fba293e..80806757a49e418208c58b803c13084b0e474542 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1806,12 +1806,13 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         for (ServerLevel serverLevel : this.getAllLevels()) {
             // ChiyoMixin start - world threading
             world.chiyomixin.thread.WorldThread worldThread = serverLevel.worldThread;
+            worldThread.setHaveTime(hasTimeLeft); // ChiyoMixin - update dynamic haveTime for this tick
             if (worldThread.getWorldTickRunnable() == null) {
             worldThread.setWorldTickRunnable(() -> {
             serverLevel.thread = Thread.currentThread();
             // ChiyoMixin end
             // ChiyoMixin start - add ChiyogamiLib
-            world.chiyogami.chiyogamilib.scheduler.WorldThreadRunnable.worldThreadHeartBeat(serverLevel.getWorld(), currentTick);
+            world.chiyogami.chiyogamilib.scheduler.WorldThreadRunnable.worldThreadHeartBeat(serverLevel.getWorld(), MinecraftServer.currentTick);
             long worldServerStartTimeNano = System.nanoTime();
             // ChiyoMixin end
             serverLevel.hasPhysicsEvent = org.bukkit.event.block.BlockPhysicsEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - BlockPhysicsEvent
@@ -1830,7 +1831,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             profilerFiller.push("tick");
 
             try {
-                serverLevel.tick(hasTimeLeft);
+                serverLevel.tick(worldThread.getHaveTime());
             } catch (Throwable var7) {
                 CrashReport crashReport = CrashReport.forThrowable(var7, "Exception ticking world");
                 serverLevel.fillReportDetails(crashReport);
diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
