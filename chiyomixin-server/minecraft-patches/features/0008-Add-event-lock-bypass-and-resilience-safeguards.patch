diff --git a/world/chiyomixin/config/EventLockBypass.java b/world/chiyomixin/config/EventLockBypass.java
new file mode 100644
index 0000000000000000000000000000000000000000..12eb93867fbc04f7f7f81c0161c3d1c23488b810
--- /dev/null
+++ b/world/chiyomixin/config/EventLockBypass.java
@@ -0,0 +1,49 @@
+package world.chiyomixin.config;
+
+import java.util.*;
+import java.util.concurrent.ConcurrentHashMap;
+
+public final class EventLockBypass {
+    private static volatile Set<String> bypassedEventClasses = Collections.emptySet();
+    private static volatile List<String> bypassedPluginPrefixes = Collections.emptyList();
+
+    private static final Map<Class<?>, Boolean> eventClassCache = new ConcurrentHashMap<>();
+    private static final Map<String, Boolean> pluginNameCache = new ConcurrentHashMap<>();
+
+    public static void setConfig(List<String> eventClasses, List<String> pluginPrefixes) {
+        bypassedEventClasses = new HashSet<>(eventClasses != null ? eventClasses : Collections.emptyList());
+        bypassedPluginPrefixes = new ArrayList<>(pluginPrefixes != null ? pluginPrefixes : Collections.emptyList());
+        eventClassCache.clear();
+        pluginNameCache.clear();
+    }
+
+    public static boolean isEventBypassed(Class<?> eventClass) {
+        if (eventClass == null || bypassedEventClasses.isEmpty()) {
+            return false;
+        }
+        return eventClassCache.computeIfAbsent(eventClass, clazz -> {
+            Class<?> current = clazz;
+            while (current != null && current != Object.class) {
+                if (bypassedEventClasses.contains(current.getName())) {
+                    return true;
+                }
+                current = current.getSuperclass();
+            }
+            return false;
+        });
+    }
+
+    public static boolean isPluginBypassed(String pluginName) {
+        if (pluginName == null || bypassedPluginPrefixes.isEmpty()) {
+            return false;
+        }
+        return pluginNameCache.computeIfAbsent(pluginName, name -> {
+            for (String prefix : bypassedPluginPrefixes) {
+                if (name.equalsIgnoreCase(prefix) || name.startsWith(prefix)) {
+                    return true;
+                }
+            }
+            return false;
+        });
+    }
+}
diff --git a/world/chiyomixin/log/SafeguardLogger.java b/world/chiyomixin/log/SafeguardLogger.java
new file mode 100644
index 0000000000000000000000000000000000000000..3991986bea7fb14b5042a16e4689e382e88ba2d5
--- /dev/null
+++ b/world/chiyomixin/log/SafeguardLogger.java
@@ -0,0 +1,40 @@
+package world.chiyomixin.log;
+
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.logging.Level;
+import org.bukkit.Bukkit;
+
+public final class SafeguardLogger {
+    private static final ConcurrentHashMap<String, RateLimitEntry> rateLimitMap = new ConcurrentHashMap<>();
+    private static final long RATE_LIMIT_WINDOW_MS = 5000L;
+
+    private static class RateLimitEntry {
+        long lastLoggedTime = 0;
+        final AtomicInteger suppressedCount = new AtomicInteger(0);
+    }
+
+    public static void logSafeguardException(String context, Throwable t) {
+        if (t == null) return;
+        String key = context + ":" + t.getClass().getName() + ":" + (t.getMessage() != null ? t.getMessage() : "");
+        long now = System.currentTimeMillis();
+        RateLimitEntry entry = rateLimitMap.computeIfAbsent(key, k -> new RateLimitEntry());
+
+        synchronized (entry) {
+            if (now - entry.lastLoggedTime >= RATE_LIMIT_WINDOW_MS) {
+                int suppressed = entry.suppressedCount.getAndSet(0);
+                entry.lastLoggedTime = now;
+                String msg = "[ChiyoMixin-Safeguard] Caught & suppressed exception in " + context +
+                        (suppressed > 0 ? " (" + suppressed + " similar suppressed in last 5s)" : "");
+                if (Bukkit.getServer() != null) {
+                    Bukkit.getLogger().log(Level.WARNING, msg, t);
+                } else {
+                    System.err.println(msg);
+                    t.printStackTrace();
+                }
+            } else {
+                entry.suppressedCount.incrementAndGet();
+            }
+        }
+    }
+}
